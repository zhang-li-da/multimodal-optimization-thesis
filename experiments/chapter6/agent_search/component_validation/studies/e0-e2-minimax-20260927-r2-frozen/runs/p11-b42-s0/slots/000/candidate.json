{
  "id": 3,
  "name": "progressive_return_regret",
  "intent": "Scale return-distance emphasis with tour progress so early steps stay purely local (avoiding premature bias toward start closure) while late steps respect closure cost; add a small regret term so that when nearest candidates are near-tied we pick the one we'd regret leaving behind. This keeps the local-distance backbone but reduces myopic tentacles on uniform instances where the constant-weight parent overcommits early and pays a long return.",
  "tags": [
    "return_aware",
    "regret"
  ],
  "reported_tags": [
    "return_aware",
    "regret"
  ],
  "allocated_tag": "local_distance",
  "code": "def priority(f):\n    return -f[\"distance\"] + f[\"progress\"] * 0.3 * f[\"return_distance\"] + 0.15 * f[\"regret\"]",
