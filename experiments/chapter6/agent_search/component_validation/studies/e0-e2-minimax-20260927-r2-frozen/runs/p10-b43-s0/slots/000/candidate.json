{
  "id": 3,
  "name": "regret_augmented_return",
  "intent": "Combine outward exploration (return_distance) with commitment pressure (regret). The return term (0.2) prevents start-proximal spirals by rewarding candidates farther from city 0. The regret term (0.1) favors candidates with a uniquely close unvisited neighbor, so we visit them before losing that short follow-up hop. This addresses grid topology where pure return-aware loops poorly, by adding bounded lookahead that promotes path continuity through neighborhoods while preserving the parent's outward bias.",
  "tags": [
    "local_distance",
    "hybrid"
  ],
  "reported_tags": [
    "local_distance",
    "hybrid"
  ],
  "allocated_tag": "local_distance",
  "code": "def priority(f):\n    d = f[\"distance\"]\n    rd = f[\"return_distance\"]\n    rg = f[\"regret\"]\n    return -d + 0.2 * rd + 0.1 * rg\n",
