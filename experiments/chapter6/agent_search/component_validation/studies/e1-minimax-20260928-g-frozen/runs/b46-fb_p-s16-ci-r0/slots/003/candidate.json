{
  "id": 22,
  "name": "cluster_lookahead",
  "intent": "Extend the parent's cluster-aware scoring by adding a nearest_remaining lookahead term to prioritize candidates that have a close unvisited neighbor, encouraging intra-cluster chaining. The return weight retains the parent's progress ramp but with a slightly milder cluster-density reduction (0.25 instead of 0.3) to stay in dense regions. Regret weight is boosted by cluster density to force finishing clusters before exiting. This targets clustered instances while preserving bounded coefficients and distance-dominant grounding.",
  "tags": [
    "cluster",
    "lookahead"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    p = f['progress']\n    reg = f['regret']\n    cd = f['cluster_density']\n    nr = f['nearest_remaining']\n    return -d + (0.1 + 0.4 * p) * (1 - 0.25 * cd) * rd + (0.2 + 0.3 * cd) * reg - 0.15 * nr",
  "source": "live_llm",
