{
  "id": 19,
  "name": "sub_return_regret_lookahead",
  "intent": "Subtracting the progress-weighted return distance penalizes candidates far from start, promoting compact tours that spiral outward from the start, beneficial for grid instances. Increasing regret weight enhances tie-breaking when multiple equidistant options exist, common on grids. Adding a nearest_remaining penalty discourages isolated candidates that would force long subsequent jumps, improving connectivity.",
  "tags": [
    "return_aware",
    "lookahead"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    nr = f['nearest_remaining']\n    p = f['progress']\n    rg = f['regret']\n    cd = f['cluster_density']\n    return -d - (0.10 + 0.30*p)*rd + 0.30*rg - 0.05*nr + 0.03*cd\n",
