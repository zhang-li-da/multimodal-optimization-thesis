{
  "id": 21,
  "name": "RegretLookaheadReturn",
  "intent": "Strengthen the regret signal to better discriminate candidates in uniform and grid layouts where nearest‑neighbor distances are similar. Add a bounded lookahead term that penalizes a large nearest remaining distance, discouraging choices that would force a long subsequent jump. Keep distance as the primary driver, but modulate the return penalty more aggressively with progress so the tour length tightens later. A small density bonus preserves cluster handling. The combination aims to keep local coherence while reducing regret‑driven long edges.",
  "tags": [
    "regret",
    "lookahead"
  ],
  "code": "def priority(f):\n    d=f['distance']; r=f['regret']; nr=f['nearest_remaining']\n    ret=f['return_distance']; p=f['progress']; cd=f['cluster_density']\n    return -d + 0.35*r - 0.15*nr + (0.10 + 0.35*p)*ret + 0.05*cd",
