{
  "id": 20,
  "name": "return_aware_progress_tapered_regret",
  "intent": "Taper the seed's return-distance weight linearly with tour progress so the early-tour spread bias fades toward the end, and add a small regret term that meaningfully shifts ranking only near the tour's end where deferring a high-regret node is costly.",
  "tags": [
    "return_aware",
    "progress"
  ],
