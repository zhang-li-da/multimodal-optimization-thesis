{
  "id": 21,
  "name": "balanced_regret_density",
  "intent": "Lead with insertion regret to avoid forced expensive insertions later; reinforce with cluster density to favor cities embedded in unvisited neighborhoods (compact tours). A small return-distance penalty discourages stranding cities far from the start. Distance remains the dominant anchor to prevent large jumps, addressing the noted risk of distance-ignoring terms in TSP.",
  "tags": [
    "regret",
    "cluster"
  ],
