{
  "id": 20,
  "name": "return_aware_chain_regret",
  "intent": "Extends the return_aware seed by adding a cluster-density preference (encourages chaining nearby unvisited cities for compact sub-tours) and a moderate regret term (favors candidates whose nearest unvisited neighbor is clearly closer than the second-nearest, signaling a committed follow-up move). Distance stays the dominant negative term to preserve greedy locality; the return-distance weight is bumped slightly to push outward exploration before closing the loop. All features are normalized, so coefficients remain bounded and comparable across instances.",
  "tags": [
    "return_aware",
    "hybrid"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    cd = f['cluster_density']\n    rg = f['regret']\n    p = -1.0 * d + 0.30 * rd + 0.15 * cd + 0.20 * rg\n    return p",
