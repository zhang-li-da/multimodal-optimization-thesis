{
  "id": 19,
  "name": "QuadraticRegretDensity",
  "intent": "Amplify distance penalty with a quadratic term to avoid long edges, and scale regret by inverse nearest remaining to favor look-ahead in dense regions early, while preserving progress-modulated return closure and early cluster density.",
  "tags": [
    "local_distance",
    "nonlinear"
  ],
  "code": "def priority(f):\n    d = f[\"distance\"]\n    r = f[\"return_distance\"]\n    nr = f[\"nearest_remaining\"]\n    g = f[\"regret\"]\n    p = f[\"progress\"]\n    cd = f[\"cluster_density\"]\n    return -d - 0.2 * d * d + (0.15 + 0.35 * p) * r + (0.30 - 0.10 * p) * g / (1.0 + nr + 1e-9) + 0.08 * (1.0 - p) * cd\n",
