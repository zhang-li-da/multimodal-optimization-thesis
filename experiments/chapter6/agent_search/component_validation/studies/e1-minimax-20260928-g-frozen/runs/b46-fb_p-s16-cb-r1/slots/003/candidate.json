{
  "id": 22,
  "name": "cluster_density_modulated",
  "intent": "Adds a progress-modulated cluster density term to the parent's return+regret+lookahead base. Early in the tour, it rewards candidates with many unvisited neighbors within mean distance, encouraging completion of the current cluster before crossing to others. The weight decays with progress, avoiding late-game bias toward dense but distant nodes, while preserving the parent's late return bias and regret-based dead-end avoidance.",
  "tags": [
    "cluster",
    "lookahead"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    p = f['progress']\n    reg = f['regret']\n    nr = f['nearest_remaining']\n    cd = f['cluster_density']\n    term1 = -d\n    term2 = 0.25 * (1 + p) * rd\n    term3 = 0.15 * (1 - p) * reg\n    term4 = -0.12 * nr\n    term5 = 0.25 * (1 - p) * cd\n    return term1 + term2 + term3 + term4 + term5",
  "source": "live_llm",
