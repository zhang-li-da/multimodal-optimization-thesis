{
  "id": 20,
  "name": "return_aware_regret",
  "intent": "Add a modest regret term (0.15 * regret) to the base return-aware linear combination. The base term balances current distance and return distance. The regret term, which measures how much better the nearest unvisited neighbor is compared to the second nearest, nudges the construction to visit relatively isolated nodes earlier, potentially reducing late-stage return costs. This keeps distance dominance while introducing a bounded lookahead.",
  "tags": [
    "return_aware",
    "regret"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    r = f['regret']\n    return -d + 0.25 * rd + 0.15 * r",
