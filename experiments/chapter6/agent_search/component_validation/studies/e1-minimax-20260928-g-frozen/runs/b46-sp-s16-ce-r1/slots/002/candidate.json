{
  "id": 21,
  "name": "Regret Amplified by Cluster Density",
  "intent": "This heuristic amplifies the regret term in dense clusters, where the consequences of missing a node are greater, while penalizing candidates that are far from other unvisited cities. The combination aims to produce a more context-sensitive selection than pure regret.",
  "tags": [
    "regret",
    "nonlinear"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['regret']\n    cd = f['cluster_density']\n    nr = f['nearest_remaining']\n    return -d + 0.3 * r * (1 + 0.5 * cd) - 0.1 * nr",
