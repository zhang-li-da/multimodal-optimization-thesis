{
  "id": 20,
  "name": "return_aware_cluster",
  "intent": "Augments return-aware construction with a mild cluster preference. Distance to current dominates; the 0.3 weight on return_distance prioritizes visiting outliers early to shorten the closing leg back to city 0. The 0.1 weight on cluster_density slightly favors candidates surrounded by many other unvisited nodes (within mean distance), encouraging compact sub-tour formation and reducing the risk of stranding isolated nodes. This hybrid stays anchored to local distance while diversifying the second-order signal beyond pure return geometry, and remains bounded so distance remains the primary driver.",
  "tags": [
    "return_aware",
    "cluster"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    cd = f['cluster_density']\n    return -d + 0.3 * rd + 0.1 * cd",
