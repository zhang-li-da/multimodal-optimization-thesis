{
  "id": 19,
  "name": "lookahead_regret",
  "intent": "Combine greedy nearest-neighbor with a one-step lookahead penalty on nearest_remaining (avoid jumping into sparse regions where the next hop will be long) and a regret bonus (prefer candidates whose alternatives would be much worse, capturing urgency). The two correction terms are bounded so locality dominates; the regret term breaks ties favorably when several nodes are similarly close.",
  "tags": [
    "lookahead",
    "regret"
  ],
  "code": "def priority(f):\n    d = f[\"distance\"]\n    nr = f[\"nearest_remaining\"]\n    mr = f[\"mean_remaining\"]\n    rd = f[\"return_distance\"]\n    rg = f[\"regret\"]\n    p = f[\"progress\"]\n    cd = f[\"cluster_density\"]\n    sp = f[\"spread\"]\n    base = -d - 0.15 * nr + 0.25 * rg\n    lookahead = -0.05 * (mr - nr)\n    density_bonus = 0.05 * cd\n    return_term = 0.1 * rd * (1.0 - p)\n    spread_term = -0.02 * sp\n    return base + lookahead + density_bonus + return_term + spread_term",
  "source": "live_llm",
