{
  "id": 21,
  "name": "regret_lookahead_bounded",
  "intent": "Strengthens the regret urgency signal (0.35 vs seed's 0.30) so ranking diverges from pure regret_aware when distances are close. Adds a bounded lookahead penalty (-0.12 * nearest_remaining) that down-weights candidates whose nearest remaining unvisited neighbor is far, preventing dead-end selections. Distance remains dominant, preserving competitive base quality. All terms vary across candidates, ensuring non-trivial ranking changes. Hypothesis: the lookahead term smooths early tour shape so the subsequent 2-opt refinement finds shorter cycles than pure regret under the same budget.",
  "tags": [
    "regret",
    "lookahead"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['regret']\n    nr = f['nearest_remaining']\n    return -d + 0.35 * r - 0.12 * nr",
