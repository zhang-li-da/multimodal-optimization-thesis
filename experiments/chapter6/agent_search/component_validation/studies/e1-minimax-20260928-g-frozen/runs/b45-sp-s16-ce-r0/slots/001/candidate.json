{
  "id": 20,
  "name": "return_regret_hybrid",
  "intent": "Combine return-distance balancing with a bounded one-step regret term to preserve efficient tour closure while avoiding candidates that would force expensive future detours; hypothesize useful ranking changes where pure return-aware ignores lookahead, keeping local distance dominant via fixed coefficients.",
  "tags": [
    "return_aware",
    "regret"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    reg = f['regret']\n    nr = f['nearest_remaining']\n    mr = f['mean_remaining']\n    pr = f['progress']\n    cd = f['cluster_density']\n    sp = f['spread']\n    base = -2.0 * d + 0.25 * rd + 0.4 * reg\n    safe_nr = nr + 1e-9\n    safe_mr = mr + 1e-9\n    ratio = mr / safe_nr\n    log_ratio = log1p(ratio - 1.0)\n    cluster_term = 0.1 * cd * (-(d - mr)) / safe_mr\n    spread_term = -0.05 * sp / safe_nr\n    progress_term = 0.15 * pr * (rd - d)\n    p = base + 0.3 * log_ratio + cluster_term + spread_term + progress_term\n    return p",
