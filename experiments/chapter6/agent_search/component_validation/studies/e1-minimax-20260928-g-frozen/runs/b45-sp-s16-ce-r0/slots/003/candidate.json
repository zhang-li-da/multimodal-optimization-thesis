{
  "id": 22,
  "name": "cluster_sweep",
  "intent": "Favor candidates embedded in dense unvisited neighborhoods so construction sweeps through local clusters contiguously before bridging gaps. cluster_density rewards being surrounded by many close unvisited cities; a negative mean_remaining term reinforces central positioning within a cluster. Distance remains the dominant signal with bounded cluster coefficients to avoid straying toward far-but-central nodes.",
  "tags": [
    "cluster",
    "lookahead"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    cd = f['cluster_density']\n    mr = f['mean_remaining']\n    rd = f['return_distance']\n    nr = f['nearest_remaining']\n    rg = f['regret']\n    pr = f['progress']\n    sp = f['spread']\n    score = -d + 0.3 * cd - 0.15 * mr\n    score += -0.1 * rd * (1.0 - pr)\n    score += 0.05 * nr + 0.05 * rg\n    score += -0.05 * sp\n    return score",
