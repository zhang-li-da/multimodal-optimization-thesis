{
  "id": 22,
  "name": "cluster_spread_penalty",
  "intent": "Add a spread-based penalty scaled by (1-cluster_density) to discourage selecting edge-of-cluster candidates, particularly in sparse regions, to reinforce cluster cohesion before stranding penalties apply.",
  "tags": [
    "cluster",
    "nonlinear"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['return_distance']\n    g = f['regret']\n    p = f['progress']\n    c = f['cluster_density']\n    s = f['spread']\n    return -d + (0.3 + 0.3 * p + 0.15 * (1 - c)) * r + (0.15 - 0.1 * p + 0.1 * (1 - c)) * g - 0.15 * s * (1 - c)",
  "source": "live_llm",
