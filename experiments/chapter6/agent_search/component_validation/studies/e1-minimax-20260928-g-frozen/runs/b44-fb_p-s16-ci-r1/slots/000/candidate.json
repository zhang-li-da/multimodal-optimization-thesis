{
  "id": 19,
  "name": "cluster_density_nearest_neighbor",
  "intent": "Incorporate cluster_density as an early bias to favor candidates in dense regions, which likely have many nearby unvisited cities and can reduce future travel distances. Maintain a constant regret term to prioritize stranded nodes (high regret). Use return_distance in the later stages to bias toward a short closing edge.",
  "tags": [
    "cluster",
    "progress"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['return_distance']\n    g = f['regret']\n    p = f['progress']\n    c = f['cluster_density']\n    early = 1 - p\n    return -d + 0.25 * c * early + 0.2 * r * p + 0.15 * g",
