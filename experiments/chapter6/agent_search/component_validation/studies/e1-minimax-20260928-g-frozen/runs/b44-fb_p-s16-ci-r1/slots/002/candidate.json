{
  "id": 21,
  "name": "cluster_regret_aware",
  "intent": "Mirror the parent's cluster-aware return modulation onto the regret term. Add (1-cluster_density) to the regret coefficient so sparse candidates receive stronger stranding penalties, creating symmetric sparse-context handling: return pressure rises for sparse candidates (existing) AND regret sensitivity rises for sparse candidates (new). Targets clustered instances where boundary cities between groups need amplified anti-stranding weight to avoid being isolated by the greedy distance term.",
  "tags": [
    "regret",
    "cluster"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['return_distance']\n    g = f['regret']\n    p = f['progress']\n    c = f['cluster_density']\n    return -d + (0.3 + 0.3 * p + 0.15 * (1 - c)) * r + (0.15 - 0.1 * p + 0.1 * (1 - c)) * g",
  "source": "live_llm",
