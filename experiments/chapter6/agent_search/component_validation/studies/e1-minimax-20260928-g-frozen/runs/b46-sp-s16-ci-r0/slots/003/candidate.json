{
  "id": 22,
  "name": "cluster_density_lookahead",
  "intent": "Augments the parent's progress-scaled return and regret with a cluster_density term to favor candidates embedded in dense unvisited neighborhoods, and a mean_remaining lookahead to penalize moves that raise average future distance. This biases construction toward completing clusters before departing, addressing the parent's higher clustered-instance loss.",
  "tags": [
    "cluster",
    "lookahead"
  ],
  "code": "def priority(f):\n    d = f[\"distance\"]\n    rd = f[\"return_distance\"]\n    rg = f[\"regret\"]\n    pr = f[\"progress\"]\n    cd = f[\"cluster_density\"]\n    mr = f[\"mean_remaining\"]\n    return -d + (0.25 + 0.15 * pr) * rd + 0.2 * rg + 0.25 * cd - 0.15 * mr",
