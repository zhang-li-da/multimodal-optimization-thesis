{
  "id": 21,
  "name": "regret_dominant_progress",
  "intent": "Emphasizes the regret family signal to better handle cluster transitions in clustered instances, where the parent underweighted end-of-cluster forcing. Scales regret inversely with progress (0.40 early to 0.30 late) so cluster-jumping decisions dominate when few cities are visited; return-distance is kept modest and slightly progress-scaled (0.20 to 0.25) for closing-cost awareness without overpowering regret.",
  "tags": [
    "regret",
    "progress"
  ],
  "code": "def priority(f):\n    d = f[\"distance\"]\n    rd = f[\"return_distance\"]\n    rg = f[\"regret\"]\n    pr = f[\"progress\"]\n    return -d + (0.20 + 0.05 * pr) * rd + (0.40 - 0.10 * pr) * rg",
