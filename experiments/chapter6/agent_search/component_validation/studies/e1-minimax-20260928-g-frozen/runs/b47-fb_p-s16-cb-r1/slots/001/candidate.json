{
  "id": 20,
  "name": "progress_adaptive_density_aware",
  "intent": "Decrease regret weight with progress (0.35 to 0.20) since future flexibility matters less as remaining options shrink, freeing priority for return-distance weighting that grows with progress (0.18 to 0.48). Add small positive cluster_density reward (0.08) to prefer candidates embedded in dense neighborhoods, helping clustered instances. Slightly reduce spread penalty to retain diverse candidates when needed. Expected to improve late-tour decisions and cluster handling without hurting uniform or grid performance.",
  "tags": [
    "progress",
    "cluster"
  ],
  "code": "def priority(f):\n    progress = f['progress']\n    ret_w = 0.18 + 0.30 * progress\n    reg_w = 0.35 - 0.15 * progress\n    return -f['distance'] + ret_w * f['return_distance'] + reg_w * f['regret'] - 0.08 * f['nearest_remaining'] - 0.04 * f['spread'] + 0.08 * f['cluster_density']",
