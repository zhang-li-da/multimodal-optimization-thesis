{
  "id": 22,
  "name": "cluster_density_aware",
  "intent": "Add a positive weight on cluster_density to explicitly prefer candidates that sit in dense neighborhoods of unvisited cities, reinforcing cluster-family compactness. Slightly reduce return penalty progress slope and spread penalty to let density dominate mid-tour decisions. Keeps regret for gap closure and base nearest-neighbor edge cost.",
  "tags": [
    "cluster",
    "regret"
  ],
  "code": "def priority(f):\n    progress = f['progress']\n    return_weight = 0.20 + 0.25 * progress\n    return_penalty = return_weight * f['return_distance']\n    regret_bonus = 0.30 * f['regret']\n    cluster_bonus = 0.20 * f['cluster_density']\n    spread_penalty = 0.03 * f['spread']\n    return -f['distance'] + return_penalty + regret_bonus + cluster_bonus - spread_penalty",
  "source": "live_llm",
