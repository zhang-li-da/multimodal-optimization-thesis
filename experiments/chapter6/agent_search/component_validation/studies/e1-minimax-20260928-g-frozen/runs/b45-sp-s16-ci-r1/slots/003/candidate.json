{
  "id": 22,
  "name": "cluster_amplified_distance_v1",
  "intent": "Apply a cluster_density-modulated amplifier to the distance signal so dense clusters (where local distance ranking is highly informative) strongly favor nearest neighbors, enabling efficient cluster sweeping while preserving the parent's return ramp and regret decay for inter-cluster transitions and final commit. Hypothesis: clustered instances have clear local winners, so amplifying -distance in dense regions improves within-cluster construction without harming uniform/grid where density varies.",
  "tags": [
    "cluster",
    "nonlinear"
  ],
  "code": "def priority(f):\n    progress = f['progress']\n    cluster_density = f['cluster_density']\n    d_amp = 1.0 + 0.25 * cluster_density * (1.0 - 0.3 * progress)\n    rw = 0.2 + 0.45 * progress\n    rgw = 0.35 - 0.25 * progress\n    cl = 0.15 * cluster_density * (1.0 - progress)\n    return -d_amp * f['distance'] + rw * f['return_distance'] + rgw * f['regret'] + cl * f['nearest_remaining']",
  "source": "live_llm",
  "parent_id": 20,
  "reference_id": null,
