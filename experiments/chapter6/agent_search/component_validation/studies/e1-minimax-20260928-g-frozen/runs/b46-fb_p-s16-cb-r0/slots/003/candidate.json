{
  "id": 22,
  "name": "cluster_density_decay",
  "intent": "Reduce parent's nearest_remaining anti-cluster bias (penalized cluster-dense candidates where nr is uniformly small) and add a cluster_density term modulated by (1-progress), so dense-area candidates dominate early when full clusters can be swept efficiently. Late game, progress-modulated return dominates for closure. Retains the regret base for early dead-end avoidance in non-cluster regions.",
  "tags": [
    "cluster",
    "return_aware"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    p = f['progress']\n    reg = f['regret']\n    nr = f['nearest_remaining']\n    cd = f['cluster_density']\n    return -d + 0.25 * (1 + p) * rd + 0.15 * (1 - p) * reg - 0.06 * nr + 0.30 * (1 - p) * cd",
  "source": "live_llm",
