{
  "id": 20,
  "name": "return_progress_cluster_lookahead",
  "intent": "Prioritize nearest neighbor while increasing the influence of the return distance as the tour progresses (the return leg becomes more critical later), reward candidates in dense clusters to avoid future long jumps, and penalize isolated candidates with large nearest-neighbor distance. This balances immediate cost, final return cost, and local connectivity.",
  "tags": [
    "return_aware",
    "cluster"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    nr = f['nearest_remaining']\n    mr = f['mean_remaining']\n    rg = f['regret']\n    p = f['progress']\n    cd = f['cluster_density']\n    sp = f['spread']\n    score = -d + 0.3 * rd * (1 + 0.5 * p) + 0.15 * cd - 0.1 * nr\n    return score",
