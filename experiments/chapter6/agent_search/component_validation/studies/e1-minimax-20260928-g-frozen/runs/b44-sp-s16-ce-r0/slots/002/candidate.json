{
  "id": 21,
  "name": "regret_cluster_aware",
  "intent": "Extends the regret-aware baseline by adding a cluster density term to favor candidates that are centrally located in dense unvisited regions, while mildly penalizing candidates that are far from the start as the tour progresses to encourage early return. This adjusts rankings on a subset where distance is similar but cluster density or return distance differ.",
  "tags": [
    "regret",
    "cluster"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    rg = f['regret']\n    pr = f['progress']\n    cd = f['cluster_density']\n    result = -d + 0.3 * rg + 0.15 * cd - 0.1 * pr * rd\n    return result",
