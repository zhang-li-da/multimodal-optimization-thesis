{
  "id": 19,
  "name": "LookaheadRegretLocal",
  "intent": "Prioritize the nearest city but soften the greedy choice by considering how close it is to other unvisited nodes (nearest_remaining) to avoid dead ends, add regret to capture urgency, and bias away from cities far from the start as the tour progresses to control return cost. This balances local optimality with a simple lookahead and end-game return awareness.",
  "tags": [
    "local_distance",
    "lookahead"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    nr = f['nearest_remaining']\n    r = f['regret']\n    p = f['progress']\n    rd = f['return_distance']\n    return -d - 0.25 * nr + 0.2 * r - 0.15 * p * rd",
