{
  "id": 22,
  "name": "ClusterDensitySqr_Compact",
  "intent": "This heuristic prioritizes candidates located in dense, compact clusters of unvisited cities. By squaring cluster_density, we amplify the advantage of high-density regions. The score subtracts a weighted distance to favor proximity, subtracts spread to prefer uniform neighborhoods, and subtracts nearest_remaining to avoid isolated nodes. The goal is to build tours that traverse clusters before jumping to distant regions, leveraging cluster_density as the primary signal.",
  "tags": [
    "cluster",
    "nonlinear"
  ],
  "code": "def priority(f):\n    cd = f['cluster_density']\n    d = f['distance']\n    sp = f['spread']\n    nr = f['nearest_remaining']\n    return cd**2 - 0.6*d - 0.3*sp - 0.2*nr",
