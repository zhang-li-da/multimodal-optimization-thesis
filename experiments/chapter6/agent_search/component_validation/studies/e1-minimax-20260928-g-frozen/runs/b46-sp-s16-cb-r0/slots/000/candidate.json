{
  "id": 19,
  "name": "density_gated_regret",
  "intent": "The parent's nonlinear regret boost fires for every candidate uniformly, but in uniform instances (low cluster_density) the second-nearest alternative is often not meaningfully closer than the nearest, so the boosted regret reflects noise rather than a true pick-now urgency. Gating the nonlinear regret by cluster_density dampens it in sparse neighborhoods (regret unreliable) and preserves the full boost in dense neighborhoods where the parent's behavior already worked. This targets the uniform-instance weakness without disrupting clustered/grid strengths, and stays bounded because density lies in [0,1].",
  "tags": [
    "regret",
    "cluster"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    nr = f['nearest_remaining']\n    r = f['regret']\n    cd = f['cluster_density']\n    denom = 0.5 + nr\n    if denom < 1e-9:\n        denom = 1e-9\n    return -d + 0.25 * rd + 0.2 * r + 0.15 * r * cd / denom",
  "source": "live_llm",
  "parent_id": 17,
  "reference_id": null,
