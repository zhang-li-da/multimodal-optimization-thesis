{
  "id": 22,
  "name": "cluster_density_amplifier",
  "intent": "Add cluster_density as a direct cluster-detection signal on top of the parent's ratio-gated regret. In uniform layouts cluster_density is approximately constant across candidates (~0.5), so it acts as a near-constant offset that preserves ranking. In clustered instances, candidates embedded in dense local neighborhoods receive a strong boost, accelerating cluster closure. The parent's cr-gated regret still suppresses noisy regret in uniform layouts, so cluster_density primarily activates in cluster instances while leaving the uniform-failure mitigation intact.",
  "tags": [
    "cluster",
    "hybrid"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    nr = f['nearest_remaining']\n    mr = f['mean_remaining']\n    r = f['regret']\n    cd = f['cluster_density']\n    cr = (mr - nr) / (mr + 1e-9)\n    denom = 0.5 + nr\n    if denom < 1e-9:\n        denom = 1e-9\n    return -d + 0.25 * rd + 0.2 * r * cr + 0.15 * r / denom + 0.35 * cd",
  "source": "live_llm",
  "parent_id": 21,
