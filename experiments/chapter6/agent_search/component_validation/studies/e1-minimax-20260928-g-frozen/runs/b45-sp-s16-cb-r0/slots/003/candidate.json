{
  "id": 22,
  "name": "cluster_completion_lookahead",
  "intent": "Augment the parent with a nearest_remaining lookahead term gated by cluster_density. In dense local regions, candidates with small nearest_remaining keep the tour inside the current cluster, enabling complete cluster traversal before crossing to other clusters. The new term is inactive for uniform instances (cd≈0, no cluster structure to exploit) and decays modestly with progress. Preserves the parent's phase-blended distance/return/regret weights so existing cluster gains are retained while adding connectivity-aware ranking that the parent lacked.",
  "tags": [
    "cluster",
    "lookahead"
  ],
  "code": "def priority(f):\n    p = f['progress']\n    cd = f['cluster_density']\n    dw = 1.0 - 0.4*p\n    rgw = (0.1 + 0.4*p*p) * (0.6 + 0.4*cd)\n    rw = 0.1 + 0.5*p*p\n    nw = 0.25*cd*(1.0 - 0.5*p)\n    return -dw*f['distance'] - nw*f['nearest_remaining'] + rw*f['return_distance'] + rgw*f['regret']",
  "source": "live_llm",
