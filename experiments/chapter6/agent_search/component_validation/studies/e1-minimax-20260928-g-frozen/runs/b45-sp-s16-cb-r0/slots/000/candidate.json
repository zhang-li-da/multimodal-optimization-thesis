{
  "id": 19,
  "name": "tightened_return_with_cluster",
  "intent": "Tighten parent's end-of-tour return ramp (max 0.60 vs 0.85) to preserve local discrimination when few cities remain. Add a small progress-ramped cluster_density term to favor chaining close unvisited cities late. Keep spread-reliability regret with a higher floor so regret persists as a secondary signal on instances where inter-candidate spread is moderate.",
  "tags": [
    "local_distance",
    "hybrid"
  ],
  "code": "def priority(f):\n    p = f['progress']\n    s = f['spread']\n    rw = 0.10 + 0.25*p + 0.25*p*p\n    rel = s / (0.4 + s + 1e-9)\n    rgw = (0.05 + 0.18*p) * (0.35 + 0.65*rel)\n    cdw = 0.04 + 0.10*p\n    return -f['distance'] + rw*f['return_distance'] + rgw*f['regret'] + cdw*f['cluster_density'] + 0.04*f['nearest_remaining']",
  "source": "live_llm",
