{
  "id": 19,
  "name": "cluster_aware_progress",
  "intent": "Extend the parent's progress-ramped return+regret score with a cluster density term weighted by (1-progress). This biases early construction toward candidates surrounded by many unvisited nodes, helping the tour stay compact in dense regions (especially beneficial for clustered instances), while the ramped return distance continues to steer late pivots toward short closure.",
  "tags": [
    "cluster",
    "progress"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    p = f['progress']\n    reg = f['regret']\n    cd = f['cluster_density']\n    return -d + (0.1 + 0.4 * p) * rd + 0.25 * reg + 0.2 * (1 - p) * cd",
