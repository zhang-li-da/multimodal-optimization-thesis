{
  "id": 22,
  "name": "progress_cluster_density",
  "intent": "Hypothesis: cluster_density (fraction of unvisited cities within instance mean distance) directly indicates whether a candidate sits inside a dense cluster. Adding +0.15*cluster_density to the parent's score biases selection toward staying inside clusters, targeting the parent's elevated clustered-instance loss (0.0454). Regret trimmed to 0.2 to keep the sum bounded; distance stays dominant to avoid loose packing; the progress-ramped return weight is preserved.",
  "tags": [
    "cluster",
    "progress"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    p = f['progress']\n    reg = f['regret']\n    cd = f['cluster_density']\n    return -d + (0.1 + 0.4 * p) * rd + 0.2 * reg + 0.15 * cd",
