{
  "id": 22,
  "name": "cluster_amplified",
  "intent": "Strengthen cluster targeting by squaring cluster density (weight 0.15) to amplify preference for dense-neighborhood candidates, helping clustered instances finish local clusters before straying. Add small -0.05*spread penalty to demote boundary candidates with high distance variance that risk stranding. Preserve parent anchor and progress-modulated return/regret terms for clean ordering and loop closure.",
  "tags": [
    "cluster",
    "nonlinear"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['return_distance']\n    g = f['regret']\n    p = f['progress']\n    c = f['cluster_density']\n    s = f['spread']\n    return -d + (0.15 + 0.20 * p) * r + (0.20 - 0.10 * p) * g + 0.15 * c ** 2 - 0.05 * s",
  "source": "live_llm",
