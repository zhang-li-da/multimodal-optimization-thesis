{
  "id": 19,
  "name": "LocalDistClusterRegret",
  "intent": "This heuristic builds on the parent by adding a cluster density term to favor candidates in dense regions (helping clustered instances) and a nearest-remaining term to penalize candidates far from other unvisited cities, improving long-term connectivity. The return and regret terms are retained to maintain tour closure and lookahead. The new terms are kept small to avoid overwhelming the primary distance signal.",
  "tags": [
    "local_distance",
    "cluster"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['return_distance']\n    g = f['regret']\n    p = f['progress']\n    c = f['cluster_density']\n    n = f['nearest_remaining']\n    return -d + (0.15 + 0.4 * p) * r + (0.25 - 0.15 * p) * g + 0.15 * c - 0.1 * n",
  "source": "live_llm",
