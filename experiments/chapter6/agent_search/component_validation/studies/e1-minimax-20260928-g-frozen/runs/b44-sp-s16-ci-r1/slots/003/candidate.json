{
  "id": 22,
  "name": "cluster_density_return_aware",
  "intent": "Bias selection toward candidates surrounded by many unvisited cities (high cluster_density) so we sweep through a cluster before paying inter-cluster travel cost. Cluster weight is largest early and decays mildly with progress, while a small return-distance term grows to ease tour closure near the end.",
  "tags": [
    "cluster",
    "return_aware"
  ],
