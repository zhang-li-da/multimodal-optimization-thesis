{
  "id": 19,
  "name": "local_distance_regret_return_hybrid",
  "intent": "Combines nearest-neighbor with return-awareness (visit far-from-start cities early to shorten the final return leg) and regret-awareness (visit uniquely close candidates urgently). The bounded nonlinear term (-0.05 * distance * regret) softly down-weights far candidates with low urgency, keeping the heuristic anchored on local distance while leveraging two complementary look-ahead signals.",
  "tags": [
    "local_distance",
    "regret"
  ],
