{
  "id": 20,
  "name": "return_aware_progressive",
  "intent": "Modulate the return-distance penalty by tour progress. Replace the seed's constant 0.25 weight with a progress-dependent weight (0.15 early, 0.40 late) so that later decisions face stronger return-awareness: as the tour extends, the remaining return trip is a larger fraction of the unbuilt portion, making return cost relatively more important. Anchored on the seed at progress~=0.4. Bounded coefficients, no distance-ignoring terms.",
  "tags": [
    "return_aware",
    "progress"
  ],
  "code": "def priority(f):\n    p = f['progress']\n    w = 0.15 + 0.25 * p\n    return -f['distance'] + w * f['return_distance']",
