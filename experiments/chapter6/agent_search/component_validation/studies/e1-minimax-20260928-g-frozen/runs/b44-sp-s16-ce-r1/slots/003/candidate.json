{
  "id": 22,
  "name": "cluster_density_bias",
  "intent": "Prefer candidates embedded in dense unvisited neighborhoods by adding a super-linear cluster_density bonus, while penalizing high distance variance. The nonlinear power amplifies preference for tight clusters, encouraging the tour to complete one region before jumping to distant outliers. This counteracts pure nearest-neighbor's tendency to leave isolated nodes stranded, reducing long transitions in clustered instances.",
  "tags": [
    "cluster",
    "nonlinear"
  ],
  "code": "def priority(f):\n    d = f[\"distance\"]\n    cd = max(f[\"cluster_density\"], 0.0)\n    sp = f[\"spread\"]\n    return -d + 0.4 * cd**1.5 - 0.15 * sp",
