{
  "id": 22,
  "name": "cluster_density_anchor",
  "intent": "Anchors nearest-neighbor with a cluster_density bonus that preferentially selects candidates surrounded by many other unvisited cities, encouraging full traversal of dense cluster regions before straying. Adds a bounded lookahead ratio, a mildly progress-gated regret term to avoid stranding, and a progress-modulated return penalty so closing the tour matters more near the end. Distance remains dominant to preserve nearest-neighbor chaining.",
  "tags": [
    "cluster",
    "hybrid"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    nr = f['nearest_remaining']\n    r = f['regret']\n    p = f['progress']\n    cd = f['cluster_density']\n    s = -d + 0.04 * nr / (d + 0.1 + 1e-9) + (0.10 + 0.15 * p) * r + 0.15 * cd + 0.18 * rd * p\n    return s",
  "source": "live_llm",
