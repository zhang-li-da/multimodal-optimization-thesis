{
  "id": 19,
  "name": "cluster_regret_v6",
  "intent": "Tone down the parent's aggressive return ramp (which amplifies noise on uniform instances where all distances are similar) and add a progress-modulated cluster_density term so candidates embedded in dense unvisited neighborhoods gain a small priority boost. This introduces a topology signal that breaks ties when distances are nearly equal on uniform instances, while preserving regret-driven ranking on clustered/grid and keeping a bounded nearest_remaining lookahead for connectivity.",
  "tags": [
    "cluster",
    "lookahead"
  ],
  "code": "def priority(f):\n    p = f[\"progress\"]\n    rw = 0.12 + 0.40 * p\n    rgw = 0.10 + 0.22 * p\n    cdw = 0.08 + 0.14 * p\n    return -f[\"distance\"] + rw * f[\"return_distance\"] + rgw * f[\"regret\"] + cdw * f[\"cluster_density\"] + 0.05 * f[\"nearest_remaining\"]",
  "source": "live_llm",
