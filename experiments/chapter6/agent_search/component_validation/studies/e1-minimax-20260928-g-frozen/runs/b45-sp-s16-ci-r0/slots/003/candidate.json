{
  "id": 22,
  "name": "cluster_bias_decay",
  "intent": "We add a cluster_density term weighted by (1 - progress) to bias early picks towards nodes in dense clusters, which is beneficial for clustered instances where visiting a cluster before moving on reduces travel. This complements the existing regret and return-aware terms. The weight decays to zero at the end so that late picks focus on distance and regret. The aim is to improve cluster performance without significantly affecting uniform or grid, as cluster_density is less discriminative there.",
  "tags": [
    "cluster",
    "lookahead"
  ],
  "code": "def priority(f):\n    rw = 0.15 + 0.55 * f[\"progress\"]\n    rgw = 0.1 + 0.25 * f[\"progress\"]\n    cluster_term = 0.3 * (1 - f[\"progress\"]) * f[\"cluster_density\"]\n    return -f[\"distance\"] + rw * f[\"return_distance\"] + rgw * f[\"regret\"] + 0.08 * f[\"nearest_remaining\"] + cluster_term",
  "source": "live_llm",
  "parent_id": 5,
  "reference_id": null,
