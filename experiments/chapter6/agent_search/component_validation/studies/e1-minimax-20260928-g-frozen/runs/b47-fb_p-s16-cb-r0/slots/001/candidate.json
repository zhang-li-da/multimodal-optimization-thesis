{
  "id": 20,
  "name": "return_aware_regret_lookahead_central",
  "intent": "Reduce uniform-instance loss by adding a small mean_remaining (centrality) penalty that breaks ties among candidates with similar current distance, regret, and 1-step lookahead. In uniform instances edge distances are nearly constant, so the average distance to remaining unvisited nodes becomes a discriminative centrality signal, favoring nodes that enable shorter future hops. Weight 0.10 is small enough to preserve the parent's strong clustered performance (where intra-cluster distance dominates) and grid performance (where distance plus nearest_remaining already encode the Manhattan structure).",
  "tags": [
    "lookahead",
    "return_aware"
  ],
  "code": "def priority(f):\n    progress = f['progress']\n    return_weight = 0.20 + 0.30 * progress\n    return_penalty = return_weight * f['return_distance']\n    return -f['distance'] + return_penalty + 0.25 * f['regret'] - 0.15 * f['nearest_remaining'] - 0.10 * f['mean_remaining']",
  "source": "live_llm",
  "parent_id": 7,
