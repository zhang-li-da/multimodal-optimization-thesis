{
  "id": 21,
  "name": "regret_lookahead_spread",
  "intent": "Strengthen the regret signal (0.25 -> 0.30) to better resolve ties in uniform instances where current edge distance is nearly constant; add a bounded spread penalty (-0.05) to prefer candidates whose distances to remaining cities have low variance (more predictable continuation, helpful in grid-like instances); reduce nearest_remaining weight (-0.15 -> -0.10) to avoid over-penalizing and let regret/distance compete more freely.",
  "tags": [
    "regret",
    "lookahead"
  ],
  "code": "def priority(f):\n    progress = f['progress']\n    return_weight = 0.20 + 0.30 * progress\n    return_penalty = return_weight * f['return_distance']\n    return -f['distance'] + return_penalty + 0.30 * f['regret'] - 0.10 * f['nearest_remaining'] - 0.05 * f['spread']",
