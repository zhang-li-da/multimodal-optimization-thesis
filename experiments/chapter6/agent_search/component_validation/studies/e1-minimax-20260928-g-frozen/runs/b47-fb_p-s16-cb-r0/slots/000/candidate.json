{
  "id": 19,
  "name": "ramped_lookahead_cluster",
  "intent": "Hypothesis: ramping the nearest_remaining weight upward with progress (0.10 to 0.25) lets later decisions exploit topological info when the tour is mostly built, and reintroducing cluster_density with a small positive weight (0.05) recovers discriminating signal on clustered instances that the parent's pure distance+nearest_remaining combination may under-emphasize. Regret kept at 0.25 to avoid over-rotation; return penalty unchanged. Targets the parent's weakest case (uniform) without regressing clustered or grid, where the parent's structure is already strong.",
  "tags": [
    "hybrid",
    "lookahead"
  ],
  "code": "def priority(f):\n    progress = f['progress']\n    return_weight = 0.20 + 0.30 * progress\n    lookahead_weight = 0.10 + 0.15 * progress\n    cluster_bonus = 0.05 * f['cluster_density']\n    return -f['distance'] + return_weight * f['return_distance'] + 0.25 * f['regret'] - lookahead_weight * f['nearest_remaining'] + cluster_bonus",
  "source": "live_llm",
  "parent_id": 7,
