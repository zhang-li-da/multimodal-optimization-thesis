{
  "id": 22,
  "name": "ClusterLookahead",
  "intent": "Prioritize candidates in dense clusters with low distance and close unvisited neighbors to construct compact tours, reducing long edges before 2-opt refinement.",
  "tags": [
    "cluster",
    "lookahead"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    nr = f['nearest_remaining']\n    cd = f['cluster_density']\n    rd = f['return_distance']\n    rg = f['regret']\n    pr = f['progress']\n    sp = f['spread']\n    p = -d + 0.7 * cd - 0.2 * nr + 0.4 * rg - 0.3 * rd * (pr ** 2) - 0.05 * sp\n    return p",
