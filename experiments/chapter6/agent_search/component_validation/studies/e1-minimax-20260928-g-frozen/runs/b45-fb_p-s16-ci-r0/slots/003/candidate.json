{
  "id": 22,
  "name": "ClusterDensityDirect-v1",
  "intent": "This heuristic extends the parent by adding a direct, progress-decaying bonus for cluster density. Early in the tour, candidates in dense regions receive a significant priority boost, encouraging the algorithm to fully explore and compact each cluster before considering sparser regions or returning to the start. This complements the existing regret and return-aware terms, explicitly targeting the cluster family while preserving the parent's lookahead dampening and spread penalty.",
  "tags": [
    "cluster",
    "regret"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    nr = f['nearest_remaining']\n    r = f['regret']\n    p = f['progress']\n    cd = f['cluster_density']\n    sp = f['spread']\n    denom = d + 0.1 + 1e-9\n    base = nr / denom\n    damp = 1 - 0.5 * cd\n    rw = 0.15 + 0.25 * (p ** 1.5)\n    rwt = 1 + 0.5 * p\n    cb = 0.20 * cd * (1 - p)\n    s = -d + 0.05 * base * damp + rw * r + 0.30 * rd * rwt - 0.02 * sp + cb\n    return s",
  "source": "live_llm",
  "parent_id": 21,
  "reference_id": null,
  "action": "develop",
