{
  "id": 19,
  "name": "stickout_spread_balanced",
  "intent": "Refines the parent's nonlinear baseline by replacing its uniform return-distance coefficient with a one-sided 'stick-out' penalty that fires only when the return hop would exceed the current step (rd > d). This directly penalizes the outward-then-back excursions that inflate grid and uniform tours without disturbing symmetric near-start configurations that help clustered instances. A small spread-based tiebreaker mildly prefers candidates with uniformly close unvisited neighbors, acting as a local-consistency signal. Regret curvature is nudged up to sharpen forced decisions near the end of the tour. All extra terms remain bounded and small relative to distance, preserving the nearest-neighbor backbone.",
  "tags": [
    "local_distance",
    "lookahead"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    nr = f['nearest_remaining']\n    r = f['regret']\n    p = f['progress']\n    s = f['spread']\n    denom = d + 0.1 + 1e-9\n    penalty = max(0, rd - d)\n    regret_coef = 0.15 + 0.30 * (p ** 1.5)\n    score = -d + 0.06 * nr / denom - 0.12 * penalty + regret_coef * r + 0.04 * (1 - s)\n    return score",
  "source": "live_llm",
