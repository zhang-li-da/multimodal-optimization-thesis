{
  "id": 19,
  "name": "compact_nn",
  "intent": "Anchor on nearest-neighbor (local distance) but bias toward candidates that stay close to remaining work. The nearest_remaining term penalizes picking cities whose closest unvisited peer is far, reducing risk of long jumps later. The small cluster_density bonus rewards cities surrounded by many unvisited peers, favoring compact regions. Both terms are bounded so they only flip ties on a useful subset without overwhelming the primary distance signal. Expected effect: tours slightly more compact than pure NN, especially mid-tour where geometric choices propagate.",
  "tags": [
    "local_distance",
    "cluster"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    nr = f['nearest_remaining']\n    cd = f['cluster_density']\n    return -d - 0.15 * nr + 0.05 * cd",
