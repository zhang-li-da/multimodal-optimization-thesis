{
  "id": 21,
  "name": "regret_dominant_nonlinear",
  "intent": "Amplify regret's influence over the seed regret_aware by raising the linear weight to 0.5 and adding a bounded sqrt(regret) term. The sublinear correction extra-rewards candidates whose omission is meaningfully costly (moderate-to-high regret where second-best is clearly worse than best), helping avoid premature commitment to a locally close but globally poor pick. Distance remains the dominant signal so regret only shifts ordering on candidates that are otherwise comparable, staying within the regret family while adding justified nonlinear emphasis.",
  "tags": [
    "regret",
    "nonlinear"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['regret']\n    r_safe = max(r, 0.0)\n    return -d + 0.5 * r + 0.15 * (r_safe ** 0.5)",
