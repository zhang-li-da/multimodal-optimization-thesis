{
  "id": 21,
  "name": "regret_focused",
  "intent": "This heuristic balances immediate travel cost with the potential regret of not visiting a city now. By weighting regret at 0.5, it favors nodes that are uniquely close to the remaining set, preventing later costly insertions. The small return-distance term gently steers the tour back toward the start, reducing the chance of a long closing arc. The combination aims to improve global structure without overemphasizing distant outliers.",
  "tags": [
    "regret",
    "return_aware"
  ],
  "code": "def priority(f):\n    return -f['distance'] + 0.5*f['regret'] + 0.1*f['return_distance']",
