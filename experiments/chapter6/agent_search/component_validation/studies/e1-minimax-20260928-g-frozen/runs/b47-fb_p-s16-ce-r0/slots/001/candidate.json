{
  "id": 20,
  "name": "progress_modulated_return_aware",
  "intent": "Modulate the return-distance coefficient by tour progress, smoothly transitioning from the seed's exploration behavior to a closure behavior. At progress=0, the coefficient equals the seed's 0.25 (prefer candidates far from start to defer loop closure). The coefficient decreases linearly with progress, crossing zero near progress=0.625 and reaching -0.15 at progress=1 (prefer candidates near start for efficient final closure). A bounded regret term (0.1) provides a secondary 1-step lookahead signal favoring candidates whose nearest unvisited neighbor is uniquely close.",
  "tags": [
    "return_aware",
    "progress"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['return_distance']\n    p = f['progress']\n    reg = f['regret']\n    coeff = 0.25 - 0.4 * p\n    return -d + coeff * r + 0.1 * reg",
