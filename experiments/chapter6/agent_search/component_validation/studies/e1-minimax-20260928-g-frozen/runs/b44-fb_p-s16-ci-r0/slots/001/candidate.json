{
  "id": 20,
  "name": "quadratic_return_with_progress",
  "intent": "Keep distance as the dominant anchor while making return-edge bias grow quadratically with progress so the heuristic behaves greedily early but pulls strongly toward short closing edges late. A constant modest regret term preserves strand-avoidance, and a light cluster-density tiebreaker favors candidates that close loops into dense remaining neighborhoods. The quadratic ramp delays return-awareness until it matters, avoiding premature long-edge detours early in the tour.",
  "tags": [
    "return_aware",
    "progress"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['return_distance']\n    p = f['progress']\n    g = f['regret']\n    cd = f['cluster_density']\n    return -d + (0.05 + 0.7 * p**2) * r + 0.1 * g + 0.05 * cd",
