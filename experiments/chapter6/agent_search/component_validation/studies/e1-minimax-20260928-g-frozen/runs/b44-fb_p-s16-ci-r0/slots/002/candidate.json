{
  "id": 21,
  "name": "Regret-Cluster-Amplified Progress-Modulated",
  "intent": "Amplify regret by cluster density to prioritize candidates with unique connections in dense regions, reducing stranding in clustered instances. As progress increases, weight shifts toward return distance to shorten the closing edge. Distance remains the primary anchor.",
  "tags": [
    "regret",
    "cluster"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['return_distance']\n    p = f['progress']\n    g = f['regret']\n    cd = f['cluster_density']\n    return -d + (0.15 + 0.25 * p) * r + (0.3 - 0.15 * p) * g * (1 + 0.5 * cd)",
