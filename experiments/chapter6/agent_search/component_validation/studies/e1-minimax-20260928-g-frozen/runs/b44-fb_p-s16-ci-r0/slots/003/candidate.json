{
  "id": 22,
  "name": "cluster_density_anchored",
  "intent": "Reward candidates with high cluster_density to commit to dense regions; penalize high spread to skip scattered outliers. Progress modulation boosts return_distance in late tour for a tight closing edge while keeping regret as a mild anti-stranding signal. Distance remains the primary anchor, but cluster_density gains enough weight to redirect between clusters when distance ties are ambiguous.",
  "tags": [
    "cluster",
    "progress"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['return_distance']\n    g = f['regret']\n    p = f['progress']\n    c = f['cluster_density']\n    s = f['spread']\n    return -d + 0.4 * c - 0.15 * s + (0.15 + 0.3 * p) * r + (0.1 - 0.05 * p) * g",
