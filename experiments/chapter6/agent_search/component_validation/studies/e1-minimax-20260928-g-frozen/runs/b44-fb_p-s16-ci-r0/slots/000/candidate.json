{
  "id": 19,
  "name": "cluster_aware_hybrid",
  "intent": "Add a cluster_density term to the parent heuristic to bias candidate selection toward nodes that are surrounded by many other unvisited cities within mean distance. This encourages the tour to visit central nodes in dense regions early, which may improve connectivity in clustered instances. The weight 0.15 is small enough to preserve the distance anchor and the progress-based modulation of return_distance and regret. Hypothesis: this will reduce tour length on clustered instances without harming uniform or grid performance.",
  "tags": [
    "cluster",
    "hybrid"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['return_distance']\n    g = f['regret']\n    p = f['progress']\n    c = f['cluster_density']\n    return -d + (0.25 + 0.3 * p) * r + (0.15 - 0.1 * p) * g + 0.15 * c",
  "source": "live_llm",
