{
  "id": 21,
  "name": "progress_regret_stranded",
  "intent": "Build on the regret-aware seed by amplifying regret's weight with tour progress, since later insertions cost more when fewer cities remain. Add a bounded (1−cluster_density)·regret bonus so isolated, high-regret candidates—those prone to forcing costly return trips—are grabbed while we are already near them. Extra terms stay within roughly 0–0.45·regret so the local-distance anchor remains dominant and regret never overwhelms proximity.",
  "tags": [
    "regret",
    "nonlinear"
  ],
  "code": "def priority(f):\n    d = f[\"distance\"]\n    r = f[\"regret\"]\n    p = f[\"progress\"]\n    c = f[\"cluster_density\"]\n    return -d + 0.3 * r * (1 + 0.5 * p) + 0.15 * (1 - c) * min(r, 1.0)",
  "source": "live_llm",
