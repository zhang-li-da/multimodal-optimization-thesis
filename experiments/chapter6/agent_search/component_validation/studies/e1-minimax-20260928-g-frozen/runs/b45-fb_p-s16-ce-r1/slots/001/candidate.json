{
  "id": 20,
  "name": "return_aware_lookahead",
  "intent": "This heuristic builds on the return-aware baseline by adding a small penalty for the nearest remaining unvisited distance to prefer candidates that keep future legs short, and a modest regret term to break ties when a candidate is uniquely close to the rest of the set. The added terms are bounded (≤0.2) to avoid overwhelming the primary distance signal, while preserving the return-distance bias of the family.",
  "tags": [
    "return_aware",
    "lookahead"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    nr = f['nearest_remaining']\n    rg = f['regret']\n    return -d + 0.25*rd - 0.2*nr + 0.1*rg",
