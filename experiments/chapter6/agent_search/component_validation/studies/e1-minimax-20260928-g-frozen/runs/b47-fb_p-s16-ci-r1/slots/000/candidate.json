{
  "id": 19,
  "name": "lookahead_mean_remaining_v1",
  "intent": "Add a bounded lookahead penalty using mean_remaining to discourage candidates that would strand us far from the remaining unvisited cities, anticipating the next jump cost. The parent's regret term helps uniform topology but underperforms on grid (0.052) where distances are regular; mean_remaining signals isolation more directly there. Distance remains dominant; return and regret weights are slightly reduced to make room. This should reduce the late-tour long-jump penalty without disturbing the well-performing clustered case.",
  "tags": [
    "lookahead",
    "return_aware"
  ],
  "code": "def priority(f):\n    progress = f['progress']\n    return_weight = 0.15 + 0.25 * progress\n    return_penalty = return_weight * f['return_distance']\n    regret_bonus = 0.20 * f['regret']\n    isolation_penalty = 0.10 * f['mean_remaining']\n    return -f['distance'] + return_penalty + regret_bonus - isolation_penalty",
  "source": "live_llm",
