{
  "id": 20,
  "name": "nonlinear_regret_blend",
  "intent": "Replace linear regret bonus with sqrt to amplify small regret values common in grid and uniform topologies where nearest-neighbor ties flatten linear discrimination. Combined with a reduced, slower-growing return penalty (max 0.35 vs 0.50) to avoid forcing suboptimal late-stage picks on grids where many candidates share similar return costs. Distance remains dominant for local coherence; density bonus kept low. The sqrt transform ensures marginal regret differentials still influence ranking, helping grids escape nearest-neighbor traps.",
  "tags": [
    "nonlinear",
    "regret"
  ],
  "code": "def priority(f):\n    progress_term = 0.10 + 0.25 * f['progress']\n    return_penalty = progress_term * f['return_distance']\n    regret_bonus = 0.30 * sqrt(max(f['regret'], 0.0))\n    density_bonus = 0.05 * f['cluster_density']\n    return -f['distance'] + return_penalty + regret_bonus + density_bonus",
  "source": "live_llm",
