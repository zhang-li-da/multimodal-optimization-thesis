{
  "id": 21,
  "name": "Regret-Augmented Return-Aware Progress",
  "intent": "Combine the parent's progress-scaled return-awareness with a progress-modulated regret term. Early steps act like a soft nearest-neighbor with light return penalty (good for clustered exploration). As progress grows, both return-awareness and regret weight increase, pushing late picks toward candidates that shorten the closing leg and that would be costly to defer. This mitigates the parent's weakness of committing too greedily to locally close but globally expensive early neighbors.",
  "tags": [
    "regret",
    "return_aware"
  ],
  "code": "def priority(f):\n    d = f[\"distance\"]\n    rd = f[\"return_distance\"]\n    r = f[\"regret\"]\n    p = f[\"progress\"]\n    return -d + (0.2 + 0.3 * p) * rd + 0.25 * p * r\n",
  "source": "live_llm",
  "parent_id": 20,
  "reference_id": null,
