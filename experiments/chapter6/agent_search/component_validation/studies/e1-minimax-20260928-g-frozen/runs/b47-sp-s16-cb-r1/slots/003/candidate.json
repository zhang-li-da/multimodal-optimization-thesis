{
  "id": 22,
  "name": "cluster_anchor",
  "intent": "Augment the parent's progress-scaled return+regret scheme with explicit cluster-aware tiebreakers while keeping distance dominant. cluster_density positively rewards candidates sitting at the center of dense unvisited neighborhoods, encouraging sweeps that commit to one cluster as a unit. A small negative weight on nearest_remaining penalizes boundary candidates whose nearest cluster mate is far, suppressing premature cross-cluster bridges. The parent's regret term is retained for late-tour cleanup of cluster seams.",
  "tags": [
    "cluster",
    "regret"
  ],
  "code": "def priority(f):\n    d = f[\"distance\"]\n    rd = f[\"return_distance\"]\n    r = f[\"regret\"]\n    p = f[\"progress\"]\n    cd = f[\"cluster_density\"]\n    nr = f[\"nearest_remaining\"]\n    return -d + (0.2 + 0.3 * p) * rd + 0.25 * p * r + 0.15 * cd - 0.1 * nr",
  "source": "live_llm",
