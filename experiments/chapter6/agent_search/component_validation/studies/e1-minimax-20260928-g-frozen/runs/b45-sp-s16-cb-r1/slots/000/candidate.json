{
  "id": 19,
  "name": "centroid_balance_v1",
  "intent": "Replace spread-based regret gate with cluster_density gate (more meaningful cluster validity signal) and cap return ramp at 0.55 to avoid late-stage distance neglect. Add a centroid-balance penalty -|distance-return_distance| that biases toward candidates geometrically central between current position and start, helping uniform instances where all distances look similar. Keep nearest_remaining as a small connectivity tie-breaker.",
  "tags": [
    "nonlinear",
    "hybrid"
  ],
  "code": "def priority(f):\n    p = f['progress']\n    cd = f['cluster_density']\n    d = f['distance']\n    rd = f['return_distance']\n    r = f['regret']\n    nr = f['nearest_remaining']\n    rw = min(0.1 + 0.45 * p, 0.55)\n    rel = cd / (0.5 + cd + 1e-9)\n    rgw = 0.25 * rel * (0.4 + 0.6 * p)\n    bal = -0.08 * abs(d - rd)\n    nrw = 0.08 * nr\n    return -d + rw * rd + rgw * r + bal + nrw",
  "source": "live_llm",
  "parent_id": 17,
  "reference_id": null,
