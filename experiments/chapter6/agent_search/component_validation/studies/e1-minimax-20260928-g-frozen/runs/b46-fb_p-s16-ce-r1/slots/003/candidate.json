{
  "id": 22,
  "name": "ClusterAffinity",
  "intent": "Scale distance penalty inversely with cluster density to favor moves into dense regions, add a progress-weighted return term to gently close the tour late, and lightly penalize high spread to prefer centrally connected candidates.",
  "tags": [
    "cluster",
    "return_aware"
