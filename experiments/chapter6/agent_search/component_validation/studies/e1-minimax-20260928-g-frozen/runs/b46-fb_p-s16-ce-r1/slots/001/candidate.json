{
  "id": 20,
  "name": "return_aware_cluster",
  "intent": "Compared to the basic return-aware heuristic, this variant adds a small bonus for cluster_density: the fraction of other unvisited cities within mean distance from the candidate. This introduces soft structural lookahead—cities embedded in dense unvisited regions are slightly preferred—while preserving the dominant nearest-neighbor edge selection and the far-city-early return-distance anchoring. The cluster bonus weight is bounded so distance remains the primary signal, avoiding loose packing from over-weighting non-distance features.",
  "tags": [
    "return_aware",
    "cluster"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    cd = f['cluster_density']\n    return -d + 0.25 * rd + 0.1 * cd\n",
