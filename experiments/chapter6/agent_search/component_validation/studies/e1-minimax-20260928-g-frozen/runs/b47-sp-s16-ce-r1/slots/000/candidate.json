{
  "id": 19,
  "name": "progress_aware_local_distance",
  "intent": "Nearest-neighbor base with two bounded corrections: a small regret term (0.1x) to commit early when a candidate's current-to-self gap dominates alternatives, and a progress-weighted return penalty (0.15*progress*return_distance) that grows as the tour fills, gently pulling late selections toward cities that keep the eventual return-to-start leg short. Both corrections are small to keep distance dominant and avoid loose packing.",
  "tags": [
    "local_distance",
    "progress"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    r = f['regret']\n    p = f['progress']\n    ret = f['return_distance']\n    return -d + 0.1 * r + 0.15 * p * ret",
