{
  "id": 21,
  "name": "progress_regret_uniform_focus",
  "intent": "Scale the regret weight by progress so late-tour insertions rely more on look-ahead (where TSP construction errors are hardest for 2-opt to repair), add a small mean_remaining penalty to discourage candidates that are isolated on average from unvisited nodes (unifies behavior across uniform random instances where pure nearest signals form long chains), and taper the cluster_density bonus with progress so it guides only early construction while preserving the late-game return-aware backbone.",
  "tags": [
    "regret",
    "lookahead"
  ],
  "code": "def priority(f):\n    d = f['distance']\n    rd = f['return_distance']\n    nr = f['nearest_remaining']\n    mr = f['mean_remaining']\n    r = f['regret']\n    p = f['progress']\n    cd = f['cluster_density']\n    term1 = -d\n    term2 = 0.25 * rd * (1 + p)\n    term3 = (0.04 + 0.07 * p) * r\n    term4 = -0.10 * nr\n    term5 = -0.03 * mr\n    term6 = 0.04 * cd * (1 - 0.5 * p)\n    return term1 + term2 + term3 + term4 + term5 + term6",
  "source": "live_llm",
