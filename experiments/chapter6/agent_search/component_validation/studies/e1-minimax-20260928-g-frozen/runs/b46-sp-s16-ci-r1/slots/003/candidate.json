{
  "id": 22,
  "name": "cluster_density_aware",
  "intent": "Adds a cluster_density bonus (0.12) on top of the parent's progress-scaled return-awareness and regret signal. cluster_density is high for candidates surrounded by many unvisited neighbors, so this term biases the construction toward staying within dense clusters until they are exhausted, targeting the underperforming cluster family while keeping the return-to-start pressure that helped on uniform instances.",
  "tags": [
    "cluster",
    "return_aware"
  ],
  "code": "def priority(f):\n    d = f[\"distance\"]\n    rd = f[\"return_distance\"]\n    rg = f[\"regret\"]\n    pr = f[\"progress\"]\n    cd = f[\"cluster_density\"]\n    return -d + (0.25 + 0.15 * pr) * rd + 0.2 * rg + 0.12 * cd",
