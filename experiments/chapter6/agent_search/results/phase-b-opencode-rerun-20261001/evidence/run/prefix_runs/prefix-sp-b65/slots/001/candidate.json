{
  "id": 4,
  "name": "return_regret_normalized",
  "intent": "The nonlinear term regret/(1+distance) normalizes the regret signal by the current travel cost, so nearby candidates with high regret (a much closer nearest unvisited than second-nearest) receive amplified priority, while distant candidates' regret influence is dampened. This curbs over-pulling toward far-away hubs, improving ranking stability on uniform instances where pure regret-weighting is noisier, while preserving the return-aware bias from the parent.",
  "tags": [
    "return_aware",
    "nonlinear"
  ],
  "reported_tags": [
    "return_aware",
    "nonlinear"
  ],
  "allocated_tag": "return_aware",
  "code": "def priority(f):\n    return -f[\"distance\"] + 0.2 * f[\"return_distance\"] + 0.5 * f[\"regret\"] / (1.0 + f[\"distance\"])\n",
